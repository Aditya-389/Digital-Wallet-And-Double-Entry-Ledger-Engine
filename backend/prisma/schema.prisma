generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  REFUND
  REVERSAL
  FEE
}

enum EntryType {
  DEBIT
  CREDIT
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
}

enum PaymentStatus {
    PENDING
    COMPLETED
    FAILED
}

//==========

model User {
  id              Int             @id @default(autoincrement())
  name            String?                                // Optional Field (Nullable)
  email           String          @unique
  passwordHash    String 
  refreshTokens   RefreshToken[]                     // 1. Relation field: Virtual array representing the many side
  idempotencyKeys IdempotencyKey[]
  wallets         Wallet[]        
  role            Role            @default(CUSTOMER)
  isActive        Boolean         @default(true) 
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastLoginAt     DateTime?
}


//==================================

/*
onDelete : Cascade
When a user permanentaly deleted ---> All their RefreshTokens deleted automatically 
*/

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int                                              // 2. Foreign Key: The physical column stored in the database
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)  // 3. Relation attribute
  jti       String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])                       // Find all refresh tokens belonging to this user
}

//======================================================================

model Wallet {
  id        Int       @id @default(autoincrement())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])   // No onDelete cascade because i need audit history eveb if user is deleted

  name      String?
  currency  String    @default("INR")

  isActive  Boolean   @default(true)                 // Disable a wallet without deleting history

  ledgerAccount LedgerAccount?                     // one wallet ----> one LedgerAccount
  payments      Payment[]


  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

//============================================================================

model LedgerAccount {
  id        Int      @id @default(autoincrement())

  walletId  Int      @unique

  wallet    Wallet   @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   LedgerEntry[]            // one LedgerAccount ----> Many LedgerEntries
}

//============================================================================

model LedgerTransaction {
  id          Int      @id @default(autoincrement())

  reference   String   @unique          // stable business identifier for tracing.

  type        TransactionType

  description String?

  createdAt   DateTime @default(now())

  entries     LedgerEntry[]             // many ledgerEntries ----> one transection
}

//================================================================================

model LedgerEntry {
  id            Int               @id @default(autoincrement())

  transactionId Int
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])

  accountId     Int
  account       LedgerAccount     @relation(fields: [accountId], references: [id])

  type          EntryType

  amount        Decimal           @db.Decimal(19, 4)

  createdAt     DateTime          @default(now())

  @@index([transactionId])
  @@index([accountId])
}

//=============================================================================

model IdempotencyKey {
  id           Int      @id @default(autoincrement())

  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)  // one user --> may keys

  key          String   // user A and user B may use same key, because every transactions is isolated that makes them different requests
  endpoint     String

  status       IdempotencyStatus @default(PENDING)
  requestHash  String

  responseCode Int?
  responseBody Json?  // A retry can receive the same result without executing the transfer again. not calculating again for "same idempotency key + same operation"

  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@unique([userId, key, endpoint])  // same key can be used on different operations(routes) : therefore using endpoint in index
  @@index([userId])
}

//==========================================================================================================

model Payment {
    id                Int       @id @default(autoincrement())

    walletId          Int
    wallet            Wallet    @relation(fields: [walletId], references: [id])

    providerPaymentId String    @unique

    amount            Decimal
    currency          String

    status            PaymentStatus @default(PENDING)

    createdAt         DateTime  @default(now())
    completedAt       DateTime?

    @@index([walletId])
}

//=========================================================================================================

model WebhookEvent {
    id          Int      @id @default(autoincrement())

    provider    String
    eventId     String
    eventType   String

    payload     Json

    processedAt DateTime?
    createdAt   DateTime @default(now())

    @@unique([provider, eventId])
}