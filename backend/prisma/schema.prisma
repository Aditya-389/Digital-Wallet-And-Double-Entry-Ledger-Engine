generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
}

model User {
  id              Int             @id @default(autoincrement())
  name            String?                                // Optional Field (Nullable)
  email           String          @unique
  passwordHash    String 
  refreshTokens   RefreshToken[]                     // 1. Relation field: Virtual array representing the many side
  wallets         Wallet[]        
  role            Role            @default(CUSTOMER)
  isActive        Boolean         @default(true) 
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastLoginAt     DateTime?
}


//==================================

/*
onDelete : Cascade
When a user permanentaly deleted ---> All their RefreshTokens deleted automatically 
*/

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int                                              // 2. Foreign Key: The physical column stored in the database
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)  // 3. Relation attribute
  jti       String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])                       // Find all refresh tokens belonging to this user
}

//-======================================================================

model Wallet {
  id        Int       @id @default(autoincrement())

  userId    Int
  user      User      @relation(fields: [userId], references: [id])   // No onDelete cascade because i need audit history eveb if user is deleted

  name      String?
  currency  String    @default("INR")

  isActive  Boolean   @default(true)                 // Disable a wallet without deleting history

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}